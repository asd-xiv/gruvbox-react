{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@asd14/ts-config/targets/react.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.site.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@self/*": ["./src/*"],
      "@asd14/gruvbox-react/hooks": ["../src/hooks/index.ts"],
      "@asd14/gruvbox-react/icons-nerd": ["../src/icons/nerd.ts"],
      "@asd14/gruvbox-react/ui": ["../src/ui/index.ts"]
    }
  },
  "include": ["src"]
}
