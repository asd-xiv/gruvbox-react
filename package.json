{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@asd14/gruvbox-react",
  "version": "0.1.0",
  "description": "Terminal/Gruvbox inspired React UI kit",
  "license": "Apache-2.0",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "type:lib",
      "runtime:react"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asd-xiv/gruvbox-react.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./icons-nerd": {
      "types": "./dist/icons/nerd.d.ts",
      "import": "./dist/icons/nerd.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    ".": {
      "style": "./dist/styles/index.css"
    },
    "./media.css": "./dist/styles/media.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "----UTIL": "",
    "prepare": "git config --local core.hooksPath .githook",
    "format": "eslint --fix .",
    "----CODE-QA": "",
    "lint": "eslint --quiet .",
    "typecheck:code": "tsc --noEmit --project ./.tsconfig/code.json",
    "typecheck:config": "tsc --noEmit --project ./.tsconfig/config.json",
    "typecheck:tests": "tsc --noEmit --project ./.tsconfig/tests.json",
    "typecheck": "npm run typecheck:code && npm run typecheck:config && npm run typecheck:tests",
    "unit-test": "TSX_TSCONFIG_PATH=.tsconfig/tests.json node --import tsx --import ./jsdom.config.js --test 'src/**/*.test.ts'",
    "---BUILD": "",
    "build:types": "tsc --emitDeclarationOnly --project ./.tsconfig/code.json",
    "build:js": "swc src --out-dir dist --strip-leading-paths --copy-files",
    "build:fonts": "mkdir -p dist/styles && cp -rf src/design-system/fonts dist/styles",
    "build:css": "mkdir -p dist/styles && postcss src/design-system/index.css -o dist/styles/index.css && cp src/design-system/media.css dist/styles",
    "prebuild": "rm -rf dist/* node_modules/.tmp/*.tsbuildinfo",
    "build": "npm run build:css && npm run build:fonts && npm run build:js && npm run build:types",
    "watch:js": "npm run build:js -- --watch"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@swc/helpers": "^0.5.23"
  },
  "devDependencies": {
    "@asd14/eslint-config": "^16.2.0",
    "@asd14/prettier-config": "^1.5.0",
    "@asd14/semantic-release-config": "^1.0.1",
    "@asd14/ts-config": "^1.6.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
