{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@asd14/gruvbox-react",
  "version": "4.0.0",
  "description": "Terminal/Gruvbox inspired React UI kit",
  "license": "Apache-2.0",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "type:lib",
      "runtime:react"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asd-xiv/gruvbox-react.git"
  },
  "files": [
    "dist",
    ".sh41/skills",
    "!.sh41/skills/*/.local"
  ],
  "type": "module",
  "exports": {
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./icons-nerd": {
      "types": "./dist/icons/nerd.d.ts",
      "import": "./dist/icons/nerd.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    ".": {
      "style": "./dist/styles/index.css"
    },
    "./media.css": "./dist/styles/media.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "----UTIL": "",
    "prepare": "git config --local core.hooksPath .githook",
    "format": "eslint --fix .",
    "----CODE-QA": "",
    "lint:code": "eslint --quiet .",
    "lint:css": "stylelint \"src/**/*.css\" \"docs/sandbox/src/**/*.css\"",
    "lint": "npm run lint:code && npm run lint:css",
    "typecheck:code": "tsc --noEmit --project ./.tsconfig/code.json",
    "typecheck:config": "tsc --noEmit --project ./.tsconfig/config.json",
    "typecheck:tests": "tsc --noEmit --project ./.tsconfig/tests.json",
    "typecheck:sandbox": "tsc --noEmit --project ./docs/sandbox/tsconfig.json",
    "typecheck": "npm run typecheck:code && npm run typecheck:config && npm run typecheck:tests && npm run typecheck:sandbox",
    "unit-test": "TSX_TSCONFIG_PATH=.tsconfig/tests.json node --import tsx --import ./css-modules.config.js --import ./jsdom.config.js --test 'src/**/*.test.ts' 'src/**/*.test.tsx' 'docs/sandbox/src/**/*.test.ts'",
    "---BUILD": "",
    "build:types": "tsc --emitDeclarationOnly --project ./.tsconfig/code.json",
    "build:js": "swc src --out-dir dist --strip-leading-paths --copy-files --ignore 'src/design-system/**'",
    "build:fonts": "mkdir -p dist/styles && cp -rf src/design-system/fonts dist/styles && rm -f dist/styles/fonts/*.ttf",
    "build:css": "mkdir -p dist/styles && postcss src/design-system/index.css -o dist/styles/index.css && cp src/design-system/media.css dist/styles",
    "prebuild": "rm -rf dist/* node_modules/.tmp/*.tsbuildinfo",
    "build": "npm run build:css && npm run build:fonts && npm run build:js && npm run build:types",
    "watch:js": "npm run build:js -- --watch",
    "---DOCS": "",
    "start": "vblocks serve --prefix docs/sandbox",
    "build:docs": "npm run build && vblocks build --prefix docs/sandbox"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.24",
    "sugar-high": "^2.7.0"
  },
  "devDependencies": {
    "@asd14/eslint-config": "^17.0.0",
    "@asd14/prettier-config": "^1.5.0",
    "@asd14/semantic-release-config": "^1.1.0",
    "@asd14/ts-config": "^2.0.0",
    "@asd14/vblocks": "^7.0.0",
    "@base-ui/react": "^1.9.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.33",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "stylelint": "^18.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19",
    "react-dom": "^19"
  }
}
